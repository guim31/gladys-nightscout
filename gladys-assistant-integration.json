      "default": "60",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
